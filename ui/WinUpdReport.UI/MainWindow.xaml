<Window x:Class="WinUpd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:WinUpd"
        Title="win升级报告" Width="1200" Height="800"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Opacity="0"
        Background="Transparent"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="14"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

<Grid x:Name="Root" Background="Transparent">

    <!-- 不透明底色：没有壁纸时就是这层纸；有壁纸时被壁纸盖住 -->
    <Rectangle x:Name="BaseBg" Fill="{DynamicResource BgBrush}" IsHitTestVisible="False"/>

    <!-- 个性化壁纸（清晰的那张） -->
    <Image x:Name="Wallpaper" Stretch="UniformToFill" Visibility="Collapsed"
           IsHitTestVisible="False"/>
    <!-- 毛玻璃层：只在卡片/标题栏/侧栏底下画"模糊过的壁纸"，壁纸本体保持清晰 -->
    <local:FrostLayer x:Name="Frost" Visibility="Collapsed"/>
    <!-- 蒙层放在毛玻璃之上：这样卡片内外的底图会被同样压暗/提亮，颜色完全一致 -->
    <Rectangle x:Name="Scrim" Visibility="Collapsed" IsHitTestVisible="False"
               Fill="White" Opacity="0"/>

    <Grid x:Name="AppBody">
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ================= 标题栏 ================= -->
      <Border x:Name="Titlebar" Grid.Row="0" Background="{DynamicResource BgBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="TitleDrag" Grid.Column="0" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="16,0,10,0" Background="Transparent"
                      MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown">
            <Path x:Name="TbMark" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0"
                  Stroke="{DynamicResource InkBrush}" StrokeThickness="1.35"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M 2,3 L 14,3 L 14,11 L 2,11 Z M 5.4,14 L 10.6,14 M 8,11 L 8,14"/>
            <TextBlock Text="win升级报告" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Rectangle Width="1" Height="12" Fill="{DynamicResource LineStrongBrush}" Margin="13,0,13,0"
                       VerticalAlignment="Center"/>
            <Ellipse x:Name="TbDot" Width="7" Height="7" Fill="{DynamicResource LineStrongBrush}"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="TbStateText" Text="正在读取…" FontSize="12"
                       Foreground="{DynamicResource Ink3Brush}" Margin="7,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnHint" FontSize="12" Foreground="{DynamicResource BadBrush}"
                       Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <TextBlock x:Name="SavedHint" Text="" FontSize="11.5"
                       Foreground="{DynamicResource Ink3Brush}" VerticalAlignment="Center"
                       Width="92" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                       Margin="0,0,14,0"/>
            <Button Style="{StaticResource WinBtn}" Click="Min_Click" ToolTip="最小化"
                    Content="&#xE921;"/>
            <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Click="Max_Click"
                    ToolTip="最大化" Content="&#xE922;"/>
            <Button Style="{StaticResource WinBtnClose}" Click="Close_Click"
                    ToolTip="关闭窗口（后台继续运行）" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= 正文：侧栏 + 页面 ================= -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="232"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0" Background="{DynamicResource BgBrush}">
          <Grid Margin="14,12,14,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="NavHost" Grid.Row="0">
              <StackPanel x:Name="NavList">
                <TextBlock Text="监控" Style="{StaticResource NavGroup}"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE80F;"
                             CommandParameter="overview" Content="概览" IsChecked="True"
                             Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE895;"
                             CommandParameter="channels" Content="更新线" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xEA8F;"
                             CommandParameter="notify" Content="通知" Click="Nav_Click"/>

                <TextBlock Text="外观与行为" Style="{StaticResource NavGroup}"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE790;"
                             CommandParameter="personalize" Content="个性化" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;"
                             CommandParameter="settings" Content="设置" Click="Nav_Click"/>

                <TextBlock Text="运行与记录" Style="{StaticResource NavGroup}"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7E8;"
                             CommandParameter="startup" Content="自启与后台" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7C3;"
                             CommandParameter="reports" Content="报告" Click="Nav_Click"/>
                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE756;"
                             CommandParameter="logs" Content="日志与诊断" Click="Nav_Click"/>
              </StackPanel>
              <Border x:Name="NavIndicator" Width="3" Height="18" CornerRadius="1.5"
                      Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                      VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="1">
                <Border.RenderTransform>
                  <TranslateTransform Y="0"/>
                </Border.RenderTransform>
              </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
              <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,14"/>
              <Button x:Name="SelfcheckBtn" Style="{StaticResource BtnSecondary}"
                      Content="体检并自动修复" HorizontalAlignment="Stretch"
                      Click="Selfcheck_Click"/>
              <TextBlock Text="关闭窗口后，后台继续监控" FontSize="11.5"
                         Foreground="{DynamicResource Ink3Brush}" Margin="3,12,0,7"/>
              <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                <Button Style="{StaticResource LinkBtn}" Content="关闭窗口" Click="CloseLink_Click"
                        ToolTip="只关闭设置窗口，后台监控继续运行"/>
                <Button x:Name="QuitBtn" Style="{StaticResource LinkDanger}" Content="完全退出"
                        Margin="14,0,0,0" Click="Quit_Click"
                        ToolTip="停止后台监控并退出程序"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="1" x:Name="ContentArea">
          <!-- 页面容器：翻页时新旧两页短暂并存，做方向一致的换页动画 -->
          <Grid x:Name="PageHost" ClipToBounds="True"/>

          <!-- 底部活动条：浮在内容上，不推挤页面布局 -->
          <Border x:Name="ActivityBar" VerticalAlignment="Bottom" Height="38"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                  Visibility="Collapsed" IsHitTestVisible="False">
            <Grid Margin="42,0,34,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ActivitySpinner" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                         FontSize="13" Foreground="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform Angle="0"/>
                </TextBlock.RenderTransform>
              </TextBlock>
              <TextBlock x:Name="ActivityText" Grid.Column="1" Text="" FontSize="12"
                         Foreground="{DynamicResource Ink2Brush}" VerticalAlignment="Center"
                         Margin="9,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- ================= Toast ================= -->
    <StackPanel x:Name="ToastHost" VerticalAlignment="Top" HorizontalAlignment="Right"
                Width="380" Margin="0,56,20,0" IsHitTestVisible="False"/>

    <!-- ================= 原生报告阅读器 ================= -->
    <Grid x:Name="ReaderOverlay" Visibility="Collapsed" Background="#4D000000">
      <Border x:Name="ReaderPanel" Background="{DynamicResource SurfaceBrush}"
              CornerRadius="18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              Width="920" MaxWidth="1000" MaxHeight="740" VerticalAlignment="Center"
              HorizontalAlignment="Center">
        <Border.Effect>
          <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.20"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="26,18,20,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="报告" Style="{StaticResource Overline}"/>
              <TextBlock x:Name="ReaderTitle" Text="报告" FontSize="17" FontWeight="SemiBold"
                         Margin="0,4,16,0" TextTrimming="CharacterEllipsis"
                         FontFamily="{StaticResource UiDisplayFont}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ReaderBrowserBtn" Style="{StaticResource BtnSecondary}"
                      Content="在浏览器打开" Padding="12,6" Click="ReaderBrowser_Click"/>
              <Button Style="{StaticResource BtnSecondary}" Content="打开文件夹"
                      Padding="12,6" Margin="10,0,0,0" Click="ReaderFolder_Click"/>
              <Button Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}"
                      Margin="10,0,0,0" ToolTip="关闭阅读（Esc）" Click="ReaderClose_Click"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource LineBrush}" Margin="26,0,26,0"/>
          <FlowDocumentScrollViewer x:Name="ReaderHost" Grid.Row="2" Margin="20,10,14,16"
                                    VerticalScrollBarVisibility="Auto"
                                    IsToolBarVisible="False" Background="Transparent"
                                    SelectionBrush="{DynamicResource AccentSoftBrush}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>


